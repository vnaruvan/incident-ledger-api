DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/incident_intelligence
OPENAI_API_KEY=
VECTOR_DIM=1536
EMBEDDINGS_MODE=local  # Force $0 local deterministic embeddings for demo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Optional Vault KV v2. When enabled, unavailable Vault fails startup.
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN_FILE=/run/secrets/vault-token
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PATH=incident-ledger
# VAULT_NAMESPACE=
# VAULT_CACERT=/path/to/ca.pem

# Optional S3 archive. Credentials come from the AWS SDK / IAM role.
# S3_ARCHIVE_BUCKET=incident-ledger-archives
# AWS_DEFAULT_REGION=us-west-2
# S3_SSE=AES256
# For customer-managed KMS encryption use S3_SSE=aws:kms and set:
# S3_KMS_KEY_ID=arn:aws:kms:us-west-2:123456789012:key/your-key-id
